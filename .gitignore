# Build products
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Generated project (source of truth is project.yml; regenerate with `make project`)
DownloadManager.xcodeproj/

# Evidence bundles are generated locally and not tracked (paths recorded in handoffs)
Artifacts/validation/*/
!Artifacts/validation/.gitkeep

# Test service scratch state
.build/test-services/

# SwiftPM
.swiftpm/
Package.resolved.backup

# Private planning / specification pack — intentionally NOT published.
# These are the owner's internal plans (master plan, PRD, architecture,
# phase prompts). Kept locally; referenced by AGENTS.md but not distributed.
macos-download-manager-prompt-pack/

# Local IDE state
.vscode/

# Xcode target build/ (used when building ChromeNativeHost without DerivedData)
build/

# macOS
.DS_Store

# Tooling caches
Scripts/.tool-cache/
# Exact-pin binaries from `make bootstrap-tools` (SwiftFormat, …)
Tools/bin/

# Vendored native build outputs (rebuilt by `make vendor-libcurl`)
VendorBuild/.cache/
VendorBuild/prefix/


# Generated release binaries (attach to GitHub Releases, do not commit).
# Two 23 MB zips were committed once and still weigh down .git — keep the
# payloads out. The small text artifacts here (*.sha256, sbom.txt,
# appcast.example.xml, sparkle/*.md) stay tracked on purpose.
Artifacts/release/*.dmg
Artifacts/release/*.zip
Artifacts/release/dmg-stage/
Artifacts/release/dmg-stage-zip/
Artifacts/release/sparkle/*.zip
Artifacts/release/sparkle/*.delta

# Locally captured gate/CI output. Checked-in evidence is *.md only.
Artifacts/validation/*.log
Artifacts/validation/*.txt
Artifacts/validation/*.zip
