{
  "manifest_version": 3,
  "name": "Flow DM",
  "short_name": "Flow DM",
  "version": "0.3.3",
  "description": "Send links to Flow Download Manager via the local native host.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "tabs",
    "storage",
    "downloads"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send page link to Flow DM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": []
}
