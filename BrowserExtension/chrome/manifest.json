{
  "manifest_version": 3,
  "name": "Flow Download Manager Companion",
  "version": "0.3.0",
  "description": "Send links to Flow Download Manager via the local native host.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "tabs",
    "storage",
    "downloads"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send page link to Download Manager",
    "default_popup": "popup.html"
  },
  "host_permissions": []
}
